DIALOG[0] = "[character,alaska,happy][delay,1]* Are you girls ready to\n  wreck that place\n  tonight?[/page]";
DIALOG[1] = "[character,destiny,smug][delay,1]* More than it already\n  is?[/page]";
DIALOG[2] = "[character,destiny,smug][delay,1]* I think the dead guy\n  already ruined it.[/page]";
DIALOG[3] = "[character,alaska,hyped][delay,1]* ARE YOU GIRLS READY TO\n  PARTY?![/page]";
DIALOG[4] = "[character,kaitlyn,ugh][delay,1]* Not if you're gonna\n  be like that.[/page]";
DIALOG[5] = "[character,alaska,smug][delay,1]* Well you better deal\n  with it.[/page]";
DIALOG[6] = "[character,alaska,smug][delay,1]* I'm here to party and\n  make bad decisions.[beat_1]";
DIALOG_ESP[0] = "[character,alaska,happy][delay,1]* ¿Estáis listas para\n  destrozar ese sitio\n  esta noche?[/page]";
DIALOG_ESP[1] = "[character,destiny,smug][delay,1]* ¿Más de como ya\n  lo está?[/page]";
DIALOG_ESP[2] = "[character,destiny,smug][delay,1]* Creo que el tío\n  muerto ya lo ha\n  arruinado suficiente.[/page]";
DIALOG_ESP[3] = "[character,alaska,hyped][delay,1]* ¿¡ESTÁIS LISTAS PARA LA\n  FORMAR UN JALEO?![/page]";
DIALOG_ESP[4] = "[character,kaitlyn,ugh][delay,1]* No si vas a\n  actuar así.[/page]";
DIALOG_ESP[5] = "[character,alaska,smug][delay,1]* Pues mejor que te\n  vayas acostumbrando.[/page]";
DIALOG_ESP[6] = "[character,alaska,smug][delay,1]* Estoy aquí por la\n  fiesta y el tomar\n  malas decisiones.[beat_1]";
