DIALOG[0] = "[character,chai,neutral][delay,1]* I'm supposed to be\n  up on Ebott tonight.[/page]";
DIALOG[1] = "[character,chai,rolleyes][delay,1]* And tomorrow.[/page]";
DIALOG[2] = "[character,chai,angry][delay,1]* I mean,[freeze][delay,333][continue] who does mom\n  think she is?[/page]";
DIALOG[3] = "[character,chai,angry][delay,1]* I work myself to\n  death at school.[/page]";
DIALOG[4] = "[character,chai,angry][delay,1]* I help in the pit\n  all night.[/page]";
DIALOG[5] = "[character,chai,angry][delay,1]* I clean up the house\n  before I go to bed.[/page]";
DIALOG[6] = "[character,chai,angry][delay,1]* So why not give me\n  more to do?[/page]";
DIALOG[7] = "[character,chai,angry][delay,1]* Make me get ingredients\n  every night while you're\n  at it![/page]";
DIALOG[8] = "[character,chai,neutral][delay,1]* ...[/page]";
DIALOG[9] = "[character,chai,rolleyes][delay,1]* The worst part is she\n  won't let me hang\n  out with my friends.[/page]";
DIALOG[10] = "[character,chai,angry][delay,1]* Says they're bad\n  influences.[/page]";
DIALOG[11] = "[character,chai,angry][delay,1]* How are they the bad\n  ones!?[/page]";
DIALOG[12] = "[character,chai,angry][delay,1]* You're the one that\n  ran off after I told\n  you to stay put.[/page]";
DIALOG[13] = "[character,chai,angry][delay,1]* Why!?[/page]";
DIALOG[14] = "[character,chai,angry][delay,1]* What could've possessed\n  you to do something\n  this stupid?[/page]";
DIALOG[15] = "[character,chai,angry][delay,1]* I'm trying to have a\n  nice night.[/page]";
DIALOG[16] = "[character,chai,angry][delay,1]* Can't you just do\n  what I say for one\n  minute?[/page]";
DIALOG[17] = "[character,none,-1][delay,1]* (You tell her you saw dad in\n  the woods.)[/page]";
DIALOG[18] = "[character,chai,disappointedcry][delay,1]* ...[/page]";
DIALOG[19] = "[character,chai,needtolockin][delay,1]* ...[/page]";
DIALOG[20] = "[character,chai,tweakeraway][delay,1]* ...[/page]";
DIALOG[21] = "[character,chai,sobbing][delay,1]* Oh...[freeze][delay,333][continue]\n* Olive...[/page]";
DIALOG[22] = "[character,chai,sobbing][delay,1]* I didn't...[/page]";
DIALOG[23] = "[character,chai,blink][delay,1]* I didn't even...[freeze][delay,333][continue]\n* Wanna go tonight...[/page]";
DIALOG[24] = "[character,chai,sobbing][delay,1]* The only reason I'm\n  out here...[/page]";
DIALOG[25] = "[character,chai,sobbing][delay,1]* Is because they were\n  doing...[freeze][delay,333][continue]\n* Bad things...[/page]";
DIALOG[26] = "[character,chai,sobbingatyou][delay,1]* Not even for you![/page]";
DIALOG[27] = "[character,chai,sobbingatyou][delay,1]* I didn't care about\n  you until you weren't\n  in the car.[/page]";
DIALOG[28] = "[character,none,-1][delay,1]* (You tell Chai it's okay.)[/page]";
DIALOG[29] = "[character,chai,sadsmile][delay,1]* ...[/page]";
DIALOG[30] = "[character,chai,sadsmile][delay,1]* No,[freeze][delay,333][continue] Olive.[/page]";
DIALOG[31] = "[character,chai,sadsmile][delay,1]* It's not okay.[/page]";
DIALOG[32] = "[character,chai,tweaker][delay,1]* You're not another chore\n  mom gave me.[/page]";
DIALOG[33] = "[character,chai,tweaker][delay,1]* And you're not the\n  reason...[/page]";
DIALOG[34] = "[character,chai,tweaker][delay,1]* ...[chaigetup]";
DIALOG_ESP[0] = "[character,chai,neutral][delay,1]* Se supone que\n  debería estar en\n  el monte Ebott.[/page]";
DIALOG_ESP[1] = "[character,chai,rolleyes][delay,1]* Hoy y mañana.[/page]";
DIALOG_ESP[2] = "[character,chai,angry][delay,1]* Quiero decir,[freeze][delay,333][continue] quién\n  se cree mamá que\n  es?[/page]";
DIALOG_ESP[3] = "[character,chai,angry][delay,1]* Me mato a trabajar\n  en la escuela.[/page]";
DIALOG_ESP[4] = "[character,chai,angry][delay,1]* Ayudo a la pandilla\n  durante toda la\n  noche.[/page]";
DIALOG_ESP[5] = "[character,chai,angry][delay,1]* Limpio la casa antes\n  de irme a dormir.[/page]";
DIALOG_ESP[6] = "[character,chai,angry][delay,1]* ¿Por qué me da\n  más preocupaciones?[/page]";
DIALOG_ESP[7] = "[character,chai,angry][delay,1]* ¡Venga,[freeze][delay,333][continue] hazme ir a\n  por ingredientes todas\n  las noches ya...[/page]";
DIALOG_ESP[8] = "[character,chai,neutral][delay,1]* ...que estamos![/page]";
DIALOG_ESP[9] = "[character,chai,rolleyes][delay,1]* Lo peor es que no\n  deja quedar con mis\n  amigas por la noche.[/page]";
DIALOG_ESP[10] = "[character,chai,angry][delay,1]* 'Son malas influencias',[freeze][delay,333][continue]\n  dice.[/page]";
DIALOG_ESP[11] = "[character,chai,angry][delay,1]* ¿¡Cómo son ellas las\n  malas!?[/page]";
DIALOG_ESP[12] = "[character,chai,angry][delay,1]* Tú eres la que salió\n  corriendo cuando te\n  dije de quedarte...[/page]";
DIALOG_ESP[13] = "[character,chai,angry][delay,1]* ¿¡Por qué!?[/page]";
DIALOG_ESP[14] = "[character,chai,angry][delay,1]* ¿Qué te ha podido poseer\n  para que hicieras\n  algo tan estúpido?[/page]";
DIALOG_ESP[15] = "[character,chai,angry][delay,1]* Estoy intentando tener\n  una buena noche.[/page]";
DIALOG_ESP[16] = "[character,chai,angry][delay,1]* ¿No podrías hacer\n  lo que yo te digo\n  por un minuto?[/page]";
DIALOG_ESP[17] = "[character,none,-1][delay,1]* (Le dices que viste a papá\n  entrar al bosque.)[/page]";
DIALOG_ESP[18] = "[character,chai,disappointedcry][delay,1]* ...[/page]";
DIALOG_ESP[19] = "[character,chai,needtolockin][delay,1]* ...[/page]";
DIALOG_ESP[20] = "[character,chai,tweakeraway][delay,1]* ...[/page]";
DIALOG_ESP[21] = "[character,chai,sobbing][delay,1]* Oh...[freeze][delay,333][continue]\n* Olive...[/page]";
DIALOG_ESP[22] = "[character,chai,sobbing][delay,1]* Yo ni...[/page]";
DIALOG_ESP[23] = "[character,chai,blink][delay,1]* Yo ni siquiera...[freeze][delay,333][continue]\n* Quería salir hoy...[/page]";
DIALOG_ESP[24] = "[character,chai,sobbing][delay,1]* La única razón\n  del porqué estoy\n  aquí afuera...[/page]";
DIALOG_ESP[25] = "[character,chai,sobbing][delay,1]* Es porque estaban\n  haciendo...[freeze][delay,333][continue]\n* Cosas malas...[/page]";
DIALOG_ESP[26] = "[character,chai,sobbingatyou][delay,1]* ¡Ni siquiera estoy\n  aquí para tí![/page]";
DIALOG_ESP[27] = "[character,chai,sobbingatyou][delay,1]* Ni siquiera me\n  importaste hasta que\n  no te ví...[/page]";
DIALOG_ESP[28] = "[character,none,-1][delay,1]* (Le dices a Chai que está\n  bien.)[/page]";
DIALOG_ESP[29] = "[character,chai,sadsmile][delay,1]* ...[/page]";
DIALOG_ESP[30] = "[character,chai,sadsmile][delay,1]* No,[freeze][delay,333][continue] Olive.[/page]";
DIALOG_ESP[31] = "[character,chai,sadsmile][delay,1]* No está bien.[/page]";
DIALOG_ESP[32] = "[character,chai,tweaker][delay,1]* Tú no eres otro recado\n  que mamá me ha dicho\n  de hacer.[/page]";
DIALOG_ESP[33] = "[character,chai,tweaker][delay,1]* Y tú no eres la\n  razón por la que...[/page]";
DIALOG_ESP[34] = "[character,chai,tweaker][delay,1]* ...[chaigetup]";
