DIALOG[0] = "[character,shifty,shifty][delay,1]* At this point Nic\n  could open a buisness\n  with all that remodeling.[/page]";
DIALOG[1] = "[character,shifty,shifty][delay,1]* Whaddya think?[freeze][delay,333][continue]\n* Pretty great, right?[/page]";
DIALOG[2] = "[character,shifty,buggin][delay,1]* Right?[/page]";
DIALOG[3] = "[character,shifty,normal][delay,1]* Well no matter what ya\n  think you'll at least be\n  happy to hear this.[/page]";
DIALOG[4] = "[character,shifty,normal][delay,1]* The battle system in the\n  Pre-Show is gonna\n  change for the main game.[/page]";
DIALOG[5] = "[character,shifty,normal][delay,1]* Seems like the devs\n  wanted to keep things\n  simple for the prequel.[/page]";
DIALOG[6] = "[character,shifty,tweakin][delay,1]* Wouldn't expect anything\n  else from those two.[/page]";
DIALOG[7] = "[character,shifty,normal][delay,1]* Before the devs catch\n  up to me I got a few\n  more points to go over.[/page]";
DIALOG[8] = "[character,shifty,normal][delay,1]* How about we do a little\n  lightning round?[freeze][delay,333][continue] Bit of\n  lightning never hurt.[/page]";
DIALOG[9] = "[character,shifty,tweakin][delay,1]* Unless you stand under\n  a tree in a field.[/page]";
DIALOG[10] = "[character,shifty,cry][delay,1]* I'll never forget you,[freeze][delay,333][continue]\n  John.[/page]";
DIALOG[11] = "[character,shifty,cry][delay,1]* ...[/page]";
DIALOG[12] = "[character,shifty,normal][delay,1]* Alright,[freeze][delay,333][continue] let's start\n  with the game's\n  progress.[/page]";
DIALOG[13] = "[character,shifty,normal][delay,1]* From what I've seen,[freeze][delay,333][continue]\n  it looks like the\n  game's writing is done.[/page]";
DIALOG[14] = "[character,shifty,shifty][delay,1]* As in done done.[/page]";
DIALOG[15] = "[character,shifty,normal][delay,1]* Seems like the devs only\n  have one more song to\n  make too.[/page]";
DIALOG[16] = "[character,shifty,normal][delay,1]* If I'm doin' my math\n  right,[freeze][delay,333][continue] that makes over\n  sixteen tracks.[/page]";
DIALOG[17] = "[character,shifty,normal][delay,1]* On the technical side\n  of things,[freeze][delay,333][continue] looks like\n  coding's going real well.[/page]";
DIALOG[18] = "[character,shifty,normal][delay,1]* All things considered,[freeze][delay,333][continue]\n  I'm feeling confident\n  with a release date in...[/page]";
DIALOG[19] = "[character,none,-1][delay,1]* Are you promising a release\n  date without our permission?[/page]";
DIALOG[20] = "[character,shifty,buggin][delay,1]* That's my cue![/page]";
DIALOG[21] = "[character,shifty,tweakin][delay,1]* All I can say is the\n  2025 release they\n  promised is still right.[/page]";
DIALOG[22] = "[character,shifty,shifty][delay,1]* Expect some big things\n  soon,[freeze][delay,333][continue] and I'll expect\n  some bigger Gs next time.[/page]";
DIALOG[23] = "[character,shifty,cry][delay,1]* I'll never forget you,[freeze][delay,333][continue]\n  Bob.[/page]";
DIALOG[24] = "[character,shifty,cry][delay,1]* ...[/page]";
instance_create_depth(x, y, -1000, obj_textboxNEW);
