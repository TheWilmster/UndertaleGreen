DIALOG[0] = "[character,gray,dramatic][delay,1][owsprite,gray_gr,dramatic][funnylighton]* Goodbye,[freeze][delay,333][continue] cruel world![freeze][delay,333][continue]\n* I can...[freeze][delay,333][continue] I can see\n  the light![/page]";
DIALOG[1] = "[character,eden,angry][delay,1][owsprite,gray_gr,default][funnylightoff]* You can stop anytime,[freeze][delay,333][continue]\n  Gray.[/page]";
DIALOG[2] = "[character,gray,dramatic][delay,1][owsprite,gray_gr,dramatic][funnylighton2]* Little Chai...[freeze][delay,333][continue]\n* Tell my family...[freeze][delay,333][continue]\n* Tell them...[/page]";
DIALOG[3] = "[character,eden,angry][delay,1][owsprite,gray_gr,default][funnylightoff]* You know their name is\n  Olive,[freeze][delay,333][continue] right?[/page]";
DIALOG[4] = "[character,eden,angry][delay,1]* I can't believe they\n  actually told you...[/page]";
DIALOG[5] = "[character,gray,dramatic][delay,1][owsprite,gray_gr,dramatic][funnylighton2]* It's a cruel world,[freeze][delay,333][continue]\n  little Chai![/page]";
DIALOG[6] = "[character,gray,dramatic][delay,1]* A world I no longer\n  belong to.[/page]";
DIALOG[7] = "[character,eden,angry][delay,1][owsprite,gray_gr,default][funnylightoff]* I don't think you're\n  ever getting out of the\n  doghouse.[/page]";
DIALOG[8] = "[character,gray,smug][delay,1]* Listen,[freeze][delay,333][continue] it's not my\n  fault you're so easy\n  to make fun of.[/page]";
DIALOG[9] = "[character,eden,sly][delay,1]* Well it's not my fault\n  you're five-five at\n  seventeen either.[freeze][delay,333][continue] So.[/page]";
DIALOG[10] = "[character,gray,shocked][owsprite,gray_gr,happy][delay,1]* Eden![freeze][delay,333][continue]\n* I can't believe you![/page]";
DIALOG[11] = "[character,eden,sly][delay,1]* Shut up.[/page]";
DIALOG[12] = "[character,gray,happy][delay,1]* You wound me,[freeze][delay,333][continue] my pawn.[/page]";
DIALOG[13] = "[character,eden,cluckin][delay,1]* And you say I'm easy\n  to make fun of.[pitpunks]";
DIALOG_ESP[0] = "[character,gray,dramatic][delay,1][owsprite,gray_gr,dramatic][funnylighton]* ¡Adiós,[freeze][delay,333][continue] mundo cruel![freeze][delay,333][continue]\n* Ya puedo...[freeze][delay,333][continue] ¡Ya puedo\n  ver la luz![/page]";
DIALOG_ESP[1] = "[character,eden,angry][delay,1][owsprite,gray_gr,default][funnylightoff]* Vale,[freeze][delay,333][continue] vale,[freeze][delay,333][continue] ya puedes\n  parar,[freeze][delay,333][continue] Gray.[/page]";
DIALOG_ESP[2] = "[character,gray,dramatic][delay,1][owsprite,gray_gr,dramatic][funnylighton2]* Mini-Chai...[freeze][delay,333][continue]\n* Dile a mi familia...[freeze][delay,333][continue]\n* Diles que yo...[/page]";
DIALOG_ESP[3] = "[character,eden,angry][delay,1][owsprite,gray_gr,default][funnylightoff]* Su nombre es Olive,[freeze][delay,333][continue]\n  ¿sabes?[/page]";
DIALOG_ESP[4] = "[character,eden,angry][delay,1]* No me puedo creer que\n  que te lo haya contado...[/page]";
DIALOG_ESP[5] = "[character,gray,dramatic][delay,1][owsprite,gray_gr,dramatic][funnylighton2]* ¡Demasiado cruel!,[freeze][delay,333][continue]\n  ¡mini-Chai![/page]";
DIALOG_ESP[6] = "[character,gray,dramatic][delay,1]* Un mundo al que ya\n  no pertenezco.[/page]";
DIALOG_ESP[7] = "[character,eden,angry][delay,1][owsprite,gray_gr,default][funnylightoff]* Definitivamente hoy\n  vas directo al sofá.[/page]";
DIALOG_ESP[8] = "[character,gray,smug][delay,1]* Mira,[freeze][delay,333][continue] no es mi culpa\n  que me pueda meter\n  tan facilmente contigo.[/page]";
DIALOG_ESP[9] = "[character,eden,sly][delay,1]* Tampoco es mi culpa\n  que midas metro y medio\n  con 17 años...[freeze][delay,333][continue] ¿No?[/page]";
DIALOG_ESP[10] = "[character,gray,shocked][owsprite,gray_gr,happy][delay,1]* ¡Eden![freeze][delay,333][continue]\n* ¡No me lo creo![/page]";
DIALOG_ESP[11] = "[character,eden,sly][delay,1]* Calla.[/page]";
DIALOG_ESP[12] = "[character,gray,happy][delay,1]* Me hieres,[freeze][delay,333][continue] peón mío.[/page]";
DIALOG_ESP[13] = "[character,eden,cluckin][delay,1]* Y dices que soy un\n  blanco fácil para\n  tus bromas.[pitpunks]";
instance_create_depth(x, y, -1000, obj_textboxNEW);
instance_create_depth(obj_player.x, obj_player.y, -500, obj_player_dummy);
