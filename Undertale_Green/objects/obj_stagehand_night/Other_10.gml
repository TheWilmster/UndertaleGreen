DIALOG[0] = "[character,none,-1][delay,1]* Hey kid.[delay,333]\n* I got time now.[/page]";
DIALOG[1] = "[character,none,-1][delay,1]* Not easy being me,[delay,333] but\n  someone's gotta do it.[/page]";
DIALOG[2] = "[character,none,-1][delay,1]* All this peace and quiet\n  almost makes it all worth it.[delay,333]\n* You know?[/page]";
DIALOG[3] = "[character,none,-1][delay,1]* Almost.[/page]";
DIALOG[4] = "[character,none,-1][delay,1]* I still hate those four girls.";
DIALOG_ESP[0] = "[character,none,-1][delay,1]* Oye.[delay,333]\n* Por fin tengo tiempo.[/page]";
DIALOG_ESP[1] = "[character,none,-1][delay,1]* No es fácil ser yo,[delay,333] pero\n  alguien tiene que lidiar\n  con el trabajo sucio.[/page]";
DIALOG_ESP[2] = "[character,none,-1][delay,1]* Toda esta tranquilidad hace\n  que casi lo merezca.[delay,333]\n* ¿Sabes?[/page]";
DIALOG_ESP[3] = "[character,none,-1][delay,1]* Casi.[/page]";
DIALOG_ESP[4] = "[character,none,-1][delay,1]* Sigo odiando a esas cuatro\n  chicas.";
instance_create_depth(x, y, -1000, obj_textboxNEW);
